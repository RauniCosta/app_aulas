<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#1E1E1E"> <!-- Fundo Escuro VS Code -->

    <!-- LADO ESQUERDO: Lista de Arquivos -->
    <LinearLayout
        android:layout_width="250dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#252526">

        <Button
            android:id="@+id/btnAbrirPasta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:text="Abrir Pasta"
            android:backgroundTint="#007ACC"
            android:textColor="#FFFFFF"/>

        <ListView
            android:id="@+id/listaArquivos"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>

    <!-- LADO DIREITO: O Código Fonte -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvCodigoFonte"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="Selecione uma pasta e um arquivo para visualizar."
            android:textColor="#D4D4D4"
            android:textSize="16sp" />
    </ScrollView>
</LinearLayout>